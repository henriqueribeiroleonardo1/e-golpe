{
  "name": "e-golpe",
  "version": "0.5.0",
  "description": "Detector de golpes para mensagens de WhatsApp e Telegram: analisa links, boletos, Pix e roteiros de golpe e responde com um semáforo.",
  "license": "MIT",
  "author": "Henrique Ribeiro Leonardo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "bot": "tsx src/telegram-polling.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
