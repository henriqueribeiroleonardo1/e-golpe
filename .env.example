# Porta do servidor HTTP
PORT=3000

# Consulta a idade dos domínios via RDAP (grátis). Use "off" para rodar 100% offline.
DOMAIN_AGE_LOOKUP=on

# Telegram: crie o bot com o @BotFather
TELEGRAM_BOT_TOKEN=
# Obrigatório para receber o webhook (qualquer texto longo e aleatório)
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (opcional): preencha todas ou nenhuma
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v23.0
